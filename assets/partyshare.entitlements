<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What the hardened runtime is asked to allow.

  codesign --options runtime turns on a set of restrictions that a usage
  description in Info.plist does not lift. The microphone is one of them: a
  hardened build with no com.apple.security.device.audio-input is refused the
  input device by the system, before the person is ever asked, and the room
  runs on silence.

  Nothing here covers the screen. macOS gates screen capture through its own
  prompt and remembers the answer in System Settings under Privacy & Security,
  with no entitlement and no Info.plist key involved.

  Read by the codesign step of .github/workflows/release.yml. A build that is
  not signed with --options runtime ignores this file, which is why the client
  captures audio from a local build without it.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
