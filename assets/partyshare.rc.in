// The Windows resource: the icon Explorer draws for the executable, and the
// version block that the file properties dialog reads. Both are configured by
// CMake rather than written by hand, so a release cannot ship a binary whose
// properties disagree with the tag it was built from.

#include <windows.h>

IDI_ICON1 ICON "@CMAKE_SOURCE_DIR@/assets/partyshare.ico"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
  PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
  FILEOS         VOS_NT_WINDOWS32
  FILETYPE       VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    // 0409 is US English, 04b0 is Unicode. A block in a language nobody
    // declared is a block Explorer does not read.
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "PartyShare\0"
      VALUE "FileDescription",  "@PROJECT_DESCRIPTION@\0"
      VALUE "FileVersion",      "@PROJECT_VERSION@\0"
      VALUE "InternalName",     "partyshare\0"
      VALUE "OriginalFilename", "partyshare.exe\0"
      VALUE "ProductName",      "PartyShare\0"
      VALUE "ProductVersion",   "@PROJECT_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
