diff --git a/config/win/BUILD.gn b/config/win/BUILD.gn
index 069432bba..47a3558a7 100644
--- a/config/win/BUILD.gn
+++ b/config/win/BUILD.gn
@@ -17,6 +17,19 @@ import("//build/toolchain/toolchain.gni")
 assert(is_win)
 
 declare_args() {
+  # Link against the dynamic CRT on desktop Windows without turning the whole
+  # build into a component build.
+  #
+  # GN ties the two together below: a non component build on desktop gets /MT,
+  # and the only supported way to reach /MD is is_component_build=true, which
+  # also turns the output into a set of DLLs. A consumer that has to match an
+  # existing /MD binary - Qt ships as /MD and there is no /MT build of it -
+  # therefore has to choose between a runtime it cannot use and shipping the
+  # whole library. This separates the two decisions.
+  #
+  # Off by default, so a build that does not ask for it behaves as upstream.
+  win_use_dynamic_crt = false
+
   # Turn this on to have the linker output extra timing information.
   win_linker_timing = false
 
@@ -527,6 +540,9 @@ config("default_crt") {
       # contains a details explanation of what is happening with the Windows
       # CRT in Visual Studio releases related to Windows store applications.
       configs = [ ":dynamic_crt" ]
+    } else if (win_use_dynamic_crt) {
+      # Desktop Windows, asked for the dynamic CRT explicitly.
+      configs = [ ":dynamic_crt" ]
     } else {
       # Desktop Windows: static CRT.
       configs = [ ":static_crt" ]
